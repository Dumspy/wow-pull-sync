{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pull-sync",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  // The production workers.dev route stays off. Attach the custom domain
  // outside this file, and leave `routes` out so a deploy does not replace it.
  // preview_urls turns on Version URLs and workers.dev Preview URLs. Those
  // use the account workers.dev subdomain. They stay up when this route is off.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Workers Logs. `logs.enabled` persists console output and
  // `invocation_logs` adds one line per request (status, timing, outcome).
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // Upstream WCL and YouTube bodies, so a reload of a finished raid skips the
  // API calls. Without an id, `wrangler deploy` and `wrangler versions upload`
  // create the namespace. The worker runs uncached when the binding is missing.
  "kv_namespaces": [{ "binding": "PULL_CACHE" }],
  // `wrangler preview` requires this block. Assets and compatibility_date
  // stay at the top level. Bindings are not inherited, and `wrangler preview`
  // does not create namespaces, so Previews run uncached until a
  // `kv_namespaces` entry with an `id` is added here. Entries are raw upstream
  // bodies keyed by query, so sharing the production namespace is safe.
  "previews": {},
}
