{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pull-sync",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  // No workers.dev URL and no version preview URLs. ps.rger.dev is attached
  // in the infra repo. Leave `routes` out so a deploy does not replace it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
